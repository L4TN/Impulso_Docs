nst deveDisparar = diaOk && !!horario && janelaOk && !jaEnviadoHoje;\n\n  let motivo = 'OK';\n  if (!diaOk) motivo = 'Fora do dia da semana';\n  else if (!horario) motivo = 'Sem horario_disparo';\n  else if (!janelaOk) motivo = 'Fora da janela de 2 minutos';\n  else if (jaEnviadoHoje) motivo = 'Já enviado hoje (ultimo_envio_em >= início)';\n\n  item.json.deve_disparar = deveDisparar;\n  item.json.motivo = motivo;\n  item.json.debug = {\n    tz: TZ,\n    now: now.toISO(),\n    diaAtual,\n    horario_disparo: horario,\n    inicio: inicioMs ? new Date(inicioMs).toISOString() : null,\n    fim: fimMs ? new Date(fimMs).toISOString() : null,\n    ultimo_envio_em: ultimoEnvioEm,\n    ultimo_ms: ultimoMs,\n    diaOk,\n    janelaOk,\n    jaEnviadoHoje\n  };\n\n  return item;\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[8768,4304],"id":"f6780e20-8a7a-4633-8414-372b8bb61e60","name":"avaliar_disparo"},{"parameters":{"operation":"executeQuery","query":"SELECT *\nFROM dbo.campanha\nWHERE NOW() BETWEEN dt_inicio AND dt_fim\n  AND horario_disparo IS NOT NULL;\n","options":{}},"id":"4c28efe3-e80d-4ff3-aa1a-576027ec09ab","name":"Campanhas Ativas","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[8576,4304],"credentials":{"postgres":{"id":"wWH9t2h8FiiptnrM","name":"Postgres account"}}}],"connections":{"If tem link_media?1":{"main":[[{"node":"Enviar Mensagem no WhatsApp","type":"main","index":0}],[{"node":"Enviar Texto no WhatsApp1","type":"main","index":0}]]},"Enviar Texto no WhatsApp1":{"main":[[{"node":"If","type":"main","index":0}]]},"Schedule Trigger":{"main":[[{"node":"Campanhas Ativas","type":"main","index":0}]]},"Espera 2 segundos":{"main":[[{"node":"Itera sobre cada mensagem","type":"main","index":0}]]},"If":{"main":[[{"node":"Espera 2 segundos","type":"main","index":0},{"node":"campanha_log2","type":"main","index":0}],[{"node":"Preservar campanha_id","type":"main","index":0}]]},"Itera sobre cada mensagem":{"main":[[{"node":"Não faz nada1","type"